# Copy to .env and fill in. Real environment variables take precedence over this file.

# Claude API key (https://platform.claude.com). Without it the shop works but the chat reports it's offline.
ANTHROPIC_API_KEY=

# Model and reasoning effort for the consultant (effort: low | medium | high | xhigh | max).
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Server-side refusal fallback (re-runs a declined turn on Anthropic's recommended fallback model). 1 = on.
CLAUDE_FALLBACKS=1

# Store
STORE_NAME=Panelo
CURRENCY=MNT
CURRENCY_SYMBOL=₮
# Store currency per 1 USD: the workshop cost data is in USD; retail prices are rounded up to PRICE_ROUNDING.
EXCHANGE_RATE=3600
PRICE_ROUNDING=1000
# Language for visitors whose browser language isn't supported: en | mn | ru | zh | ko
DEFAULT_LANGUAGE=en

# Order desk (/admin.html) — choose a long random string.
ADMIN_TOKEN=EStkLoh7y9ngTJFAEb_TiMXVlNIywonX

# Storage (SQLite database and uploaded room photos)
# DATA_DIR=backend/data

# Gemini free tier for testing (switch back to Claude with AI_PROVIDER=anthropic)
AI_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6IWdTuqjkjLNmXOtGErPt0G1nh2fGhDIi5tZTz0yQtvvQ
GEMINI_MODEL=gemini-3-flash-preview
